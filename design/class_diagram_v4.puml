hide empty members

' ============================================================
'  LAYERS
'    0  Simulator                     the run loop
'    1  Restaurant + shared services  one evening, one venue
'    2  FrontOfTheHouse / Kitchen     subsystem facades
'    3  services                      one job each
'    4  domain objects                data and rules
'
'  A class only ever calls downwards. No layer skipping except
'  through a facade.
' ============================================================
package Main{
    class Main{
    + {static} main(args: Array<String>) : Unit
    - run(food: String, restaurants: String, scenario: String,\n maxTicks: Int, logLevel: LogLevel, out: String?) : Unit
    }
}
note bottom of Main
  main() is the thin CLI shell: it does nothing but read
  the raw argv (section 3.1: ~--food, ~--restaurants,
  ~--scenario, ~--maxTicks, ~--logLevel, ~--out), turn each
  flag into a typed value, and hand them to run().

  run() owns the actual startup: it configures the Logger,
  constructs the ConfigurationLoader with the three paths
  and maxTicks, calls load(), and - if a Simulator comes
  back - calls Simulator.run(). Nothing below Main ever
  sees an argv array or parses a flag, so the CLI format
  is isolated in one method.
end note

package ConfigPackage #lightgreen {

class ConfigurationLoader {
    - model: ParsedModel
    - parsers: MutableList<ConfigParser>
    - maxTicks: Int
    + load(): Simulator?
    - runStage(parser: ConfigParser, path: String): Boolean
    - buildSimulator(): Simulator
}

abstract class ConfigParser {
    # {abstract} schemaPath: String
    # validator: Validator
    # model: ParsedModel

    + parse(path: String): Boolean
    # {abstract} readEntities(path: String): Boolean
    # {abstract} validateFileScope(): Boolean
}
note right of ConfigParser
  parse() is unchanged: validate the file against
  schemaPath with Validator, then readEntities(path),
  then validateFileScope(). readEntities() now takes
  the path (not a parsed root) because each subclass
  deserializes into its own file-root DTO - Kotlin
  overrides cannot vary the parameter type per subclass.
end note

class Validator {
    + validateFile(path: String, schemaPath: String): Boolean
}

class ParsedModel {
    - ingredientsByName: Map<String, Ingredient>
    - recipesById: Map<Int, Recipe>
    - restaurantsById: Map<Int, Restaurant>
    - customerGroupsById: Map<Int, CustomerGroup>
    - incidentsById: Map<Int, Incident>

    + ingredient(name: String): Ingredient?
    + recipe(id: Int): Recipe?
    + restaurant(id: Int): Restaurant?
    + registerIngredient(i: Ingredient): Boolean
    + registerRecipe(r: Recipe): Boolean
    + registerRestaurant(r: Restaurant): Boolean
    + registerCustomerGroup(g: CustomerGroup): Boolean
    + registerIncident(i: Incident): Boolean
    + basicDishesFor(type: RestaurantType): Set<String>
    + allIngredientNames(): Set<String>
    + allDishNames(): Set<String>
    + allRestaurants(): MutableList<Restaurant>
    + allCustomerGroups(): MutableList<CustomerGroup>
    + allIncidents(): MutableList<Incident>
}
note right of ParsedModel
  This is the only handoff from Config to the rest of the
  system: once all three parse stages return true,
  ConfigurationLoader.buildSimulator(params) reads
  allRestaurants() / allCustomerGroups() / allIncidents()
  off this same model instance and passes them straight
  into the Simulator constructor. No second container
  (e.g. a DTO/content bundle) is needed - ParsedModel IS
  the parsed content, addressable by id/name during
  parsing and readable as flat MutableLists once parsing is done.
end note

class FoodParser {
    # readEntities(path: String): Boolean
    # validateFileScope(): Boolean
    - serialiseIngredient(ingredientDto: IngredientDto): Ingredient?
    - serialiseRecipe(recipeDto: RecipeDto): Recipe?
    - serialiseRecipeIngredients(recipeDto: RecipeDto): MutableList<RecipeIngredient>?
    .. whole file ..
    - checkBasicDishUniqueness(recipes: MutableList<Recipe>): Boolean
}
note right of FoodParser
  Ingredient, Recipe and RecipeIngredient are domain
  classes, not DTOs - they live in Shared_package (below,
  with Order/Meal/CustomerGroup) because Kitchen, Menu and
  Restaurant all construct/read them too, not just this
  parser. serialiseIngredient/serialiseRecipe/
  serialiseRecipeIngredients are exactly where a
  ...Dto (this package) turns into its domain counterpart
  (Shared_package): one IngredientDto -> one Ingredient,
  one RecipeIngredientDto -> one RecipeIngredient (a name
  string resolved to a real Ingredient reference via
  ParsedModel.ingredient(name)).
end note

class RestaurantParser {
    # readEntities(path: String): Boolean
    # validateFileScope(): Boolean
    - serialiseRestaurant(restaurantDto: RestaurantJsonDto): Restaurant?
    - resolveRecipes(restaurantDto: RestaurantJsonDto): MutableList<Recipe>?
    - serialiseCookCounts(restaurantDto: RestaurantJsonDto): Map<CookType, Int>?
    - serialiseTables(restaurantDto: RestaurantJsonDto): MutableList<Table>?
    - checkAtLeastOneOfEach(restaurantDto: RestaurantJsonDto): Boolean
    - checkBasicDishCoverage(type: RestaurantType, dishes: Set<String>): Boolean
}

class ScenarioParser {
    # readEntities(path: String): Boolean
    # validateFileScope(): Boolean
    .. customer groups ..
    - serialiseCustomerGroup(groupDto: CustomerGroupJsonDto): CustomerGroup?
    - serialiseRegularGroup(groupDto: CustomerGroupJsonDto): RegularCustomerGroup?
    - serialiseCasualGroup(groupDto: CustomerGroupJsonDto): CasualCustomerGroup?
    - serialiseEventGroup(groupDto: CustomerGroupJsonDto): EventCustomerGroup?
    - serialiseFoodPreferences(groupDto: CustomerGroupJsonDto): MutableList<FoodPreference>?
    - checkPreferenceSizes(g: CustomerGroup): Boolean
    - checkDeliveryOrderTick(g: CasualCustomerGroup): Boolean
    - checkRegularRestaurantExists(g: RegularCustomerGroup): Boolean
    - checkEventFavouriteDishPerType(g: EventCustomerGroup): Boolean
    .. incidents ..
    - serialiseIncident(incidentDto: IncidentJsonDto): Incident?
    - serialiseStaffChange(incidentDto: IncidentJsonDto): StaffChange?
    - serialiseRecipeChange(incidentDto: IncidentJsonDto): RecipeChange?
    - serialisePackagingChange(incidentDto: IncidentJsonDto): PackagingChange?
    - serialiseIngredientUnavailability(incidentDto: IncidentJsonDto): IngredientUnavailability?
    - checkUnavailabilityOverlap(incidents: MutableList<IngredientUnavailability>): Boolean
}
note right of ScenarioParser
  checkEventFavouriteDishPerType (spec 2.3.2, new validation):
  "Event customer groups need a favorite dish for every
  restaurant type they consider visiting." Checked here,
  not in FoodParser/RestaurantParser, because it needs both
  g.restaurantTypes (this file) and the basic-dish names per
  type (ParsedModel.basicDishesFor, populated in stage 1).
end note

ConfigParser <|-- FoodParser
ConfigParser <|-- RestaurantParser
ConfigParser <|-- ScenarioParser

ConfigurationLoader *--   ParsedModel   : model >
ConfigurationLoader *-- ConfigParser  : parsers >
ConfigParser        *-- Validator     : validator >
ConfigParser        --> ParsedModel   : model >


' --- JSON DTOs (kotlinx.serialization) ---
' One @Serializable data class per JSON shape from spec Figures 1-8, plus one
' root DTO per file. Json.decodeFromString<...Dto>(File(path).readText()) turns
' the already schema-validated text into these directly - no manual .getInt/
' .getString field access, and a renamed/mistyped JSON key becomes decoded
' failure instead of a silent wrong value. Field names below mirror the JSON
' keys 1:1 so no @SerialName is needed. Fields with "?" have a default and
' cover the properties that are optional per Figures 6 and 8.

class IngredientDto <<serializable>> {
    + name: String
    + unit: String
    + packagingVolume: Int
    + bestBefore: Int
}

class RecipeIngredientDto <<serializable>> {
    + name: String
    + unit: String
    + amount: Int
}

class RecipeDto <<serializable>> {
    + id: Int
    + dishName: String
    + duration: Int
    + cookType: MutableList<String>
    + ingredients: MutableList<RecipeIngredientDto>
    + basicDishFor: String?
}

class FoodFileDto <<serializable>> {
    + ingredients: MutableList<IngredientDto>
    + recipes: MutableList<RecipeDto>
}

class TableDto <<serializable>> {
    + id: Int
    + type: String
    + size: Int
}

class RestaurantJsonDto <<serializable>> {
    + id: Int
    + name: String
    + type: String
    + openingTickStart: Int
    + openingTickEnd: Int
    + deliveryDrivers: Int
    + event: Boolean?
    + positiveRatings: Int?
    + negativeRatings: Int?
    + recipes: MutableList<Int>
    + kitchenStaff: Map<String, Int>
    + waitstaff: Int
    + tables: MutableList<TableDto>
}

class RestaurantFileDto <<serializable>> {
    + restaurants: MutableList<RestaurantJsonDto>
}

class FoodPreferenceDto <<serializable>> {
    + size: Int
    + excludedIngredients: MutableList<String>?
    + preferredIngredients: MutableList<String>?
    + favoriteDishes: MutableList<String>?
}

class CustomerGroupJsonDto <<serializable>> {
    + id: Int
    + type: String
    + size: Int
    + tableType: String?
    + visitingTick: Int?
    + foodPreferences: MutableList<FoodPreferenceDto>
    .. REGULAR only ..
    + visitingStart: Int?
    + visitingPeriod: Int?
    + restaurant: Int?
    .. CASUAL only ..
    + visitingEvenings: MutableList<Int>?
    + deliveryDistance: Int?
    + ratingLikelihood: String?
    .. CASUAL and EVENT ..
    + restaurantTypes: MutableList<String>?
    .. EVENT only ..
    + eventEvening: Int?
    + favoriteDishes: Map<String, String>?
}

class IncidentJsonDto <<serializable>> {
    + id: Int
    + type: String
    + evening: Int
    .. STAFF only ..
    + restaurant: Int?
    + number: Int?
    + staffType: String?
    + cookType: String?
    .. RECIPE / PACKAGING / UNAVAILABLE only ..
    + ingredient: String?
    + adaptation: Int?
    + packagingVolume: Int?
    + duration: Int?
}

class ScenarioFileDto <<serializable>> {
    + customers: MutableList<CustomerGroupJsonDto>
    + incidents: MutableList<IncidentJsonDto>
}

FoodFileDto      *-- IngredientDto        : ingredients >
FoodFileDto      *-- RecipeDto            : recipes >
RecipeDto        *-- RecipeIngredientDto  : ingredients >

RestaurantFileDto    *-- RestaurantJsonDto : restaurants >
RestaurantJsonDto    *-- TableDto          : tables >

ScenarioFileDto       *-- CustomerGroupJsonDto : customers >
ScenarioFileDto       *-- IncidentJsonDto      : incidents >
CustomerGroupJsonDto  *-- FoodPreferenceDto    : foodPreferences >

}


