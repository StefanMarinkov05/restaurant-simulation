}
class BrowsingService {
    - entries: MutableList<RestaurantData>
    - ratings: RatingBook

    + refresh(snapshots: MutableList<RestaurantData>): Unit
    + choose(g: CustomerGroup): Int?
    + chooseForEvent(g: CustomerGroup, eventEvening: Int): Int?
