}
class RestaurantData {
    + id: Int
    + type: RestaurantType
    + openingTick: Int
    + closingTick: Int
    + dishes: MutableList<Recipe>
    + freeSeats: Map<TableType, Int>
    + freeDrivers: Int
    + hostsEvents: Boolean
    + eventSeatsBooked: Map<Int, Int>

    + take(g: CustomerGroup): Unit
    + takeForEvent(g: CustomerGroup, evening: Int): Unit
    + openAt(tick: Int): Boolean
    + eventSeatsLeft(evening: Int): Int
}

class DeliveryService {
    - allDrivers: MutableList<DeliveryDriver>
    - oderId: GrantOrderId
    + placeOrder(g: CustomerGroup, restaurant:Restaurant, tick: Int): Order?
    + chooseDriverForOrder(restaurantId: Int): Int
    + calculateTravelTicks(distance: Int):Int
    + rmDriver(restaurantId: Int): Unit
    + addDriver(restaurantId: Int): Unit
}
DeliveryService --o Restaurant
GrantOrderId --o DeliveryService
class Statistics {
    - served: Map<Int, Int>
    - delivered: Map<Int, Int>
    - cooked: Map<Int, Int>
    - ratings: Map<Int, Int>

    + record(restaurantId: Int, customers: Int, delivered: Boolean): Unit
    + recordCooked(restaurantId: Int, meals: Int): Unit
    + recordRating(restaurantId: Int): Unit
    + report(): Unit
}

class RatingBook {
    - scores: Map<Int, RatingScore>

    + initialiseRating(restaurantId: Int, positive: Int, negative: Int): Unit
    + add(restaurantId: Int, r: Rating): Unit
    + ratingScore(restaurantId: Int): RatingScore
}

class RatingScore {
    + positive: Int {positive >= 0}
    + negative: Int {negative >= 0}

    + score(): Int
}

enum Rating {
    POSITIVE
    NEGATIVE
}

enum Experience {
    NEGATIVE
    NEUTRAL
    POSITIVE
}

enum RatingLikelihood {
    NEVER
    SOME
    ALWAYS
}

}

