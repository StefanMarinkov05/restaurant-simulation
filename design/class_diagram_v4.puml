}

object GlobalClock <<<color:blue>singleton</color>>> {
    - currentTick: Int
    - evening: Int
    <color:blue>+ advanceTick(): Unit</color>
    <color:blue>+ advanceEvening(): Unit</color>
}

class GrantOrderId{
    - nextOrderId: Int {nextOrderId >= 1}
    + grantAndIncrement(): Int
}

class Restaurant {
    - id: Int {id >= 0}
    - name: String
    - type: RestaurantType
    - openingTick: Int {1 <= openingTick <= 24}
    - closingTick: Int {openingTick <= closingTick <= 24}
    - hostsEvents: Boolean
    - initialPositiveRatings: Int  {>= 0}
    - initialNegativeRatings: Int  {>= 0}
    - foh: FrontOfTheHouse
    - kitchen: Kitchen
    - pantry: Pantry
    - menu: Menu

    + prepare(evening: Int, regulars: MutableList<CustomerGroup>, supplier: Supplier): Unit
    + subunit(): SubUnits
    + closeEvening(): Unit
    + snapshot(): RestaurantData
    + bookEvent(g: CustomerGroup, evening: Int): Boolean
    + changeStaff(type: StaffType, cook: CookType?, delta: Int): Unit
    - isOpen(tick: Int): Boolean
    - deleteRegulars_failedAttempts(): Unit
}

note right of Restaurant
  initialPositiveRatings/initialNegativeRatings come straight
  from RestaurantJsonDto.positiveRatings/negativeRatings
  (default 0 if absent) - they only seed RatingBook once, in
  ConfigurationLoader.buildSimulator(), via
  RatingBook.seed(id, initialPositiveRatings, initialNegativeRatings)
  for every parsed restaurant. RatingBook does not exist yet
  while RestaurantParser runs, so the raw counts have to ride
  on Restaurant until buildSimulator can seed the book.
end note

class SubUnits {
    + restaurantId: Int
    + menu: Menu
    + pantry: Pantry
    + kitchen: Kitchen
}

class CustomerRegistry {
    - groups: MutableList<CustomerGroup>

    + regularsFor(restaurantId: Int, evening: Int): MutableList<CustomerGroup>
