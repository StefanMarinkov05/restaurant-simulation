package Incidents_package #5af904f9 {

abstract class Incident {
    - id: Int {id >= 0}
    - evening: Int {evening >= 0}

    + {abstract} type: IncidentType
    + {abstract} apply(sim: Simulator): Unit
}
note right of Incident
  apply() takes the whole Simulator, not one Restaurant,
  because only StaffChange is restaurant-scoped. RecipeChange
  and PackagingChange are global (spec: "changes all recipes
  in all restaurants that use a specific ingredient" / "the
  packaging volume of one ingredient" - the ingredient object
  is shared, so this alone reaches every recipe using it, but
  the incident still needs sim.restaurants to log/iterate).
  IngredientUnavailability acts on the shared Supplier, which
  Restaurant does not reference - only Simulator does.
end note

class StaffChange extends Incident {
    - restaurantId: Int
    - number: Int {number != 0}
    - staffType: StaffType
    - cookType: CookType? {cookType != EXEC}

    + type: IncidentType = STAFF
    + apply(sim: Simulator): Unit
}

class RecipeChange extends Incident {
    - ingredient: Ingredient
    - adaptation: Int {adaptation != 0}

    + type: IncidentType = RECIPE
    + apply(sim: Simulator): Unit
}
note right of RecipeChange
  apply(sim): for every restaurant's every recipe, find the
  RecipeIngredient(s) matching this.ingredient and call
  .adaptBy(adaptation) on each. Global and permanent (spec:
  "changes all recipes in all restaurants that use a
  specific ingredient"), not scoped to one restaurant.
end note

class PackagingChange extends Incident {
    - ingredient: Ingredient
    - packagingVolume: Int {packagingVolume > 0}

    + type: IncidentType = PACKAGING
    + apply(sim: Simulator): Unit
}

class IngredientUnavailability extends Incident {
    - ingredient: Ingredient
    - duration: Int {duration > 0}

    + type: IncidentType = UNAVAILABLE
    + apply(sim: Simulator): Unit
}

enum IncidentType {
    STAFF
    RECIPE
    PACKAGING
    UNAVAILABLE
}

}


